# Copy this file to .env and fill in real values before running in production.

# Long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# Port the server listens on (most hosts like Railway/Render set this for you automatically)
PORT=3000

# Only needed if the frontend is served from a different domain than the API.
# Leave unset if frontend + API are on the same domain (the default setup in this repo).
# CORS_ORIGIN=https://howtosysadmin.com

NODE_ENV=production

# Publishing from Claude Code (scripts/site.js -> POST /api/publish). Disabled unless set.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the SAME value on the live server and in your local .env.
# PUBLISH_TOKEN=
# Username pages are published under (must exist). Defaults to the first admin account.
# PUBLISH_AS=
# Local only: the live site that scripts/site.js talks to.
# SITE_URL=https://runbookit.wiki
